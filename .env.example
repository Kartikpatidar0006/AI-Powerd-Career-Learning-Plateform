# ──────────────────────────────────────────────
# .env.example — Copy to .env and fill in values
# ──────────────────────────────────────────────

DEBUG=false

# ── App Environment ────────────────────────────
# Set to 'development' to enable /dev/* endpoints on roadmap-agent-service
APP_ENV=development

# ── Auth Database ────────────────────────────
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=CHANGE_ME

# ── Profile Database ─────────────────────────
PROFILE_DB_NAME=profile_db
PROFILE_DB_USER=profile_user
PROFILE_DB_PASSWORD=CHANGE_ME

# ── Roadmap Database ─────────────────────────
ROADMAP_DB_NAME=roadmap_db
ROADMAP_DB_USER=roadmap_user
ROADMAP_DB_PASSWORD=CHANGE_ME

# ── Evaluator Database (Agent 3) ─────────────
EVALUATOR_DB_NAME=evaluator_db
EVALUATOR_DB_USER=evaluator_user
EVALUATOR_DB_PASSWORD=CHANGE_ME

# ── JWT ──────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Internal Service Token ───────────────────
# Shared secret for service-to-service communication (X-Internal-Token header)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_SERVICE_TOKEN=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# ── Evaluation (Agent 3) ──────────────────────
PASS_SCORE=60
GITHUB_API_TOKEN=your-github-personal-access-token-optional

# ── LLM Provider Configuration ───────────────
# Supported providers: openai, anthropic, mock
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Frontend ─────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
