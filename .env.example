# ──────────────────────────────────────────────
# .env.example — Copy to .env and fill in values
# ──────────────────────────────────────────────

DEBUG=false

# ── Auth Database ────────────────────────────
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=CHANGE_ME

# ── Profile Database ─────────────────────────
PROFILE_DB_NAME=profile_db
PROFILE_DB_USER=profile_user
PROFILE_DB_PASSWORD=CHANGE_ME

# ── JWT ──────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM Provider Configuration ───────────────
# Supported providers: openai, anthropic, mock
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Frontend ─────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
